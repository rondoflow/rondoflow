{
  "name": "rondoflow",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:spark": "turbo dev --filter=@rondoflow/ui --filter=@rondoflow/server --filter=@rondoflow/docs",
    "start:spark": "turbo start --filter=@rondoflow/ui --filter=@rondoflow/server --filter=@rondoflow/docs",
    "dev:ui": "turbo dev --filter=@rondoflow/ui",
    "dev:server": "turbo dev --filter=@rondoflow/server",
    "dev:docs": "turbo dev --filter=@rondoflow/docs",
    "dev:landing": "turbo dev --filter=@rondoflow/landing",
    "build": "turbo build",
    "catalog:build": "tsx packages/catalog/scripts/build-catalog.ts",
    "benchmark:capabilities": "npm run benchmark:capabilities --workspace @rondoflow/server",
    "sync:capabilities": "npm run sync:capabilities --workspace @rondoflow/server",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "generate": "prisma generate --schema=packages/server/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=packages/server/prisma/schema.prisma",
    "db:seed": "npx prisma db seed --schema=packages/server/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=packages/server/prisma/schema.prisma",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:all": "docker compose up --build",
    "docker:all:detach": "docker compose up --build -d",
    "setup": "npm install && npm run catalog:build && node scripts/setup-env.js && docker compose up -d --wait postgres && npm run db:migrate && npm run db:seed",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.0",
    "@changesets/cli": "^2.27.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "zod": "4.3.6"
  },
  "prisma": {
    "seed": "tsx --env-file=.env packages/server/prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "esbuild@0.27.4": true,
    "prisma@6.19.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
